# Copy to esphome/secrets.yaml and fill in. secrets.yaml is git-ignored.
wifi_ssid: "your-ssid"
wifi_password: "your-wifi-password"

# Password for the fallback access point the device raises when Wi-Fi fails.
fallback_ap_password: "at-least-8-chars"

# Generate with: esphome wizard, or https://esphome.io/components/api.html
api_encryption_key: "base64-32-byte-key=="

ota_password: "your-ota-password"
